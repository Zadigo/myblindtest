{
  "name": "television",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix --cache",
    "lint": "run-s lint:*",
    "test": "vitest run",
    "test:watch": "vitest watch --coverage",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "release": "pnpm run lint & pnpm run test && pnpm run build",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build --major",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build --minor",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build --patch"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.5",
    "@primevue/icons": "^5.0.5",
    "@stylistic/eslint-plugin": "^6.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@unhead/addons": "^3.4.3",
    "@unhead/schema-org": "^3.4.3",
    "@unhead/vue": "^3.4.3",
    "@vueuse/core": "^15.0.0",
    "@vueuse/integrations": "^15.0.0",
    "@vueuse/sound": "^2.1.3",
    "animate.css": "^4.1.1",
    "axios": "^1.21.1",
    "dayjs": "^1.11.23",
    "firebase": "^13.3.0",
    "globals": "^17.14.0",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "primevue": "^5.0.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tailwindcss-primeui": "^0.6.1",
    "tw-animate-css": "^1.4.0",
    "universal-cookie": "^8.1.2",
    "vue": "^3.5.45",
    "vue-axios-manager": "2.1.2",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1",
    "vue-sonner": "^2.0.9",
    "vuefire": "^3.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node22": "^22.0.7",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.15.0",
    "eslint-plugin-oxlint": "~1.93.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-vue": "~10.12.1",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "jwt-decode": "^4.0.0",
    "npm-run-all2": "^9.0.4",
    "oxlint": "~1.94.0",
    "sass": "^1.108.2",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.72.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "npm:rolldown-vite@^7.3.1",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
