{
  "name": "mainsite",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint lint . --type-aware --type-check",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch --coverage",
    "test:coverage": "vitest run --coverage",
    "test:nuxt": "vitest run --project nuxt",
    "test:unit": "vitest run --project unit",
    "test:playwright": "playwright test",
    "test:playwright:report": "playwright show-report",
    "test:playwright:ui": "playwright test --ui",
    "release": "pnpm run lint & pnpm run test && pnpm run build && git push --follow-tags",
    "release:major": "pnpm run lint & pnpm run test && pnpm run build --major && git push --follow-tags",
    "release:minor": "pnpm run lint & pnpm run test && pnpm run build --minor && git push --follow-tags",
    "release:patch": "pnpm run lint & pnpm run test && pnpm run build --patch && git push --follow-tags",
    "playwright:install": "playwright install --with-deps",
    "cleanup": "nuxt cleanup && rm -rf .nuxt .output dist node_modules/.cache",
    "lint:eslint": "eslint . --ext .ts,.vue",
    "fix": "oxlint fix ."
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.4.1",
    "@nuxt/image": "2.1.0",
    "@nuxt/scripts": "1.3.2",
    "@nuxtjs/i18n": "10.6.0",
    "@unhead/vue": "^3.3.0",
    "dayjs": "^1.11.21",
    "firebase": "^12.17.0",
    "nuxt": "^4.5.1",
    "nuxt-charts": "2.2.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@firebase/app-types": "^0.9.5",
    "@iconify-json/fa-brands": "^1.2.2",
    "@iconify-json/fa-solid": "^1.2.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.16.0",
    "@nuxt/kit": "^4.5.1",
    "@nuxt/test-utils": "4.1.0",
    "@pinia/nuxt": "1.0.1",
    "@playwright/test": "^1.62.1",
    "@primevue/icons": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "@vueuse/components": "^14.4.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/integrations": "^14.4.0",
    "@vueuse/math": "^14.4.0",
    "@vueuse/motion": "3.0.3",
    "@vueuse/nuxt": "14.4.0",
    "@vueuse/sound": "^2.1.3",
    "chart.js": "^4.5.1",
    "eslint": "^10.8.0",
    "firebase-admin": "^14.2.0",
    "firebase-functions": "^7.3.2",
    "happy-dom": "^20.11.1",
    "nuxt-vuefire": "1.1.2",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "pinia-plugin-persistedstate": "^4.7.1",
    "playwright": "^1.62.1",
    "playwright-core": "^1.62.1",
    "primevue": "^5.0.0",
    "sass-embedded": "^1.100.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "tw-animate-css": "^1.4.0",
